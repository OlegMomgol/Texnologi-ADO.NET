IF OBJECT_ID('college.StudentRating', 'V') IS NOT NULL
    DROP VIEW college.StudentRating;
GO

CREATE VIEW college.StudentRating
AS
SELECT
    s.id,
    s.name           AS name,
    g.name           AS group_name,
    s.average_grade  AS average_grade,
    RANK() OVER (PARTITION BY s.group_id ORDER BY s.average_grade DESC) AS group_rating
FROM college.students AS s
JOIN college.groups   AS g ON g.id = s.group_id;
GO

SELECT * FROM college.StudentRating;
GO

SELECT * FROM college.StudentRating WHERE group_name = N'ИС-31';
GO

