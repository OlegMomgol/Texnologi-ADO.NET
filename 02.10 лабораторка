USE CollegeDB;
GO

-- 1
SELECT
    s.name                                   AS student_name,
    g.name                                   AS group_name,
    s.average_grade                          AS average_grade,
    COUNT(gr.id)                             AS grades_count,
    ISNULL(AVG(CAST(gr.grade AS DECIMAL(4,2))), 0) AS avg_grade_from_grades
FROM college.students AS s
JOIN college.groups   AS g  ON s.group_id = g.id
LEFT JOIN college.grades AS gr ON gr.student_id = s.id
GROUP BY s.name, g.name, s.average_grade
ORDER BY s.average_grade DESC;
GO

-- 2

WITH StudentStats AS (
    SELECT
        s.id,
        s.name,
        s.group_id,
        s.average_grade
    FROM college.students AS s
)
SELECT
    name,
    average_grade,
    RANK() OVER (ORDER BY average_grade DESC) AS rating
FROM StudentStats
ORDER BY rating;
GO

-- 3

WITH StudentStats AS (
    SELECT
        s.id,
        s.name          AS student_name,
        s.group_id,
        s.average_grade
    FROM college.students AS s
)
SELECT
    ss.student_name,
    g.name           AS group_name,
    ss.average_grade,
    RANK() OVER (PARTITION BY ss.group_id ORDER BY ss.average_grade DESC) AS group_rating
FROM StudentStats AS ss
JOIN college.groups AS g ON g.id = ss.group_id
ORDER BY group_name, group_rating;
GO

