CREATE FUNCTION college.GetStudentsByGroup
(
    @group_id INT
)
RETURNS TABLE
AS
RETURN
(
    SELECT
        s.id,
        s.name,
        s.age,
        s.average_grade
    FROM college.students AS s
    WHERE s.group_id = @group_id
);
GO

