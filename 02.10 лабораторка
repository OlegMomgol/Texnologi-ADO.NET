WITH GradesAgg AS (
    SELECT
        student_id,
        COUNT(id) AS grades_count
    FROM college.grades
    GROUP BY student_id
)
SELECT
    sr.name                                        AS student_name,
    sr.group_name                                  AS group_name,
    sr.average_grade                               AS average_grade,
    college.GetStudentStatus(sr.average_grade)     AS status,
    RANK() OVER (
        PARTITION BY sr.group_name
        ORDER BY sr.average_grade DESC
    )                                              AS group_rating,
    ISNULL(ga.grades_count, 0)                     AS grades_count
FROM college.StudentRating AS sr
LEFT JOIN GradesAgg        AS ga ON ga.student_id = sr.id
ORDER BY sr.group_name, group_rating;
GO
