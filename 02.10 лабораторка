IF OBJECT_ID('college.student_changes', 'U') IS NOT NULL
    DROP TABLE college.student_changes;
GO

CREATE TABLE college.student_changes
(
    id                INT IDENTITY(1,1) PRIMARY KEY,
    student_id        INT           NOT NULL,
    old_average_grade DECIMAL(4,2)  NULL,
    new_average_grade DECIMAL(4,2)  NULL,
    change_date       DATETIME      NOT NULL DEFAULT GETDATE()
);
GO

IF OBJECT_ID('college.trg_Students_AverageGradeAudit', 'TR') IS NOT NULL
    DROP TRIGGER college.trg_Students_AverageGradeAudit;
GO

CREATE TRIGGER college.trg_Students_AverageGradeAudit
ON college.students
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO college.student_changes
        (student_id, old_average_grade, new_average_grade, change_date)
    SELECT
        i.id,
        d.average_grade,
        i.average_grade,
        GETDATE()
    FROM inserted AS i
    JOIN deleted  AS d ON d.id = i.id
    WHERE i.average_grade <> d.average_grade
       OR (i.average_grade IS NULL AND d.average_grade IS NOT NULL)
       OR (i.average_grade IS NOT NULL AND d.average_grade IS NULL);
END;
GO

UPDATE college.students
SET average_grade = average_grade + 0.1
WHERE id = 1;
GO

